default:
    @just --list

# Build the wasm module into web/dist/pkg (committed, since Netlify cannot build it)
build:
    wasm-pack build --target web --no-pack --release --out-dir dist/pkg
    rm -f dist/pkg/.gitignore

serve: build
    (sleep 1; open http://localhost:8123) & python3 -m http.server 8123 --directory dist

watch:
    ls Cargo.toml src/*.rs | entr -c just build

clean:
    rm -rf dist/pkg target
