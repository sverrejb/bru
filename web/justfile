default:
    @just --list

# Build the wasm module into web/dist/pkg (committed, since Netlify cannot build it)
build:
    wasm-pack build --target web --no-pack --release --out-dir dist/pkg
    rm -f dist/pkg/.gitignore

# Rebuild the social card into dist/og.png from og.html (committed, since only crawlers fetch it)
og:
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --headless --disable-gpu --hide-scrollbars --window-size=1200,630 --screenshot=dist/og.png og.html
    magick dist/og.png -colors 16 PNG8:dist/og.png

# Typecheck the page scripts
check:
    tsc --noEmit -p dist/jsconfig.json

serve: build
    (sleep 1; open http://localhost:8123) & python3 -m http.server 8123 --directory dist

watch:
    ls Cargo.toml src/*.rs | entr -c just build

clean:
    rm -rf dist/pkg target
